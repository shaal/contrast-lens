{
  "name": "contrast-lens",
  "version": "0.1.0",
  "private": true,
  "description": "A visual WCAG 2 and APCA contrast checker with an optional blur lens, built with Vue.",
  "keywords": [
    "accessibility",
    "apca",
    "contrast",
    "wcag",
    "vue",
    "vite"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "bench": "tsx bench/contrast.bench.ts",
    "check": "npm run typecheck && npm run build && npm test && npm run e2e"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "vite": "^7.1.3",
    "sass": "^1.89.2",
    "vue-tsc": "^3.3.11"
  }
}
